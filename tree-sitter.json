{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sysl",
      "camelcase": "SysL",
      "title": "Sys Language",
      "scope": "source.sysl",
      "file-types": [
        "sysl"
      ],
      "injection-regex": "^sysl$",
      "class-name": "TreeSitterSysl",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Sysl grammar for tree-sitter",
    "authors": [
      {
        "name": "eulegang",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sysl",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
